<!doctype html>
<html lang="{{ app.request.locale|default('und')|replace({'_': '-'})|escape('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{{ title|escape('html') }} · {{ status_code|escape('html') }}</title>
    <style>
        :root { color-scheme: light dark; --bg: #faf9f5; --surface: #fff; --text: #18241f; --muted: #46534c; --accent: #165b4a; --focus: #0759a5; }
        @media (prefers-color-scheme: dark) { :root { --bg: #121916; --surface: #1c2621; --text: #f2f5f0; --muted: #c0cbc3; --accent: #91dfb9; --focus: #a8d7ff; } }
        * { box-sizing: border-box; }
        body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 1.5rem; color: var(--text); background: var(--bg); font: 1rem/1.6 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        main { width: min(100%, 42rem); padding: clamp(1.5rem, 6vw, 4rem); border: 1px solid color-mix(in srgb, var(--muted), transparent 55%); border-radius: .75rem; background: var(--surface); }
        .code { margin: 0; color: var(--accent); font-size: .9rem; font-weight: 700; letter-spacing: .08em; }
        h1 { max-width: 18ch; margin: .5rem 0 1rem; font-size: clamp(2rem, 7vw, 3.5rem); line-height: 1.1; letter-spacing: -.04em; text-wrap: balance; }
        p { max-width: 60ch; color: var(--muted); }
        a { display: inline-flex; min-height: 2.75rem; align-items: center; margin-block-start: .75rem; padding: .65rem 1rem; border-radius: .4rem; color: var(--surface); background: var(--accent); font-weight: 650; text-decoration: none; }
        a:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
        @media (forced-colors: active) { main { border: 1px solid CanvasText; } a { border: 1px solid ButtonText; } }
    </style>
</head>
<body>
    <main aria-labelledby="error-title">
        <p class="code">ERROR {{ status_code|escape('html') }}</p>
        <h1 id="error-title">{{ title|escape('html') }}</h1>
        <p>{{ message|escape('html') }}</p>
        <a href="/">{{ action_label|escape('html') }}</a>
    </main>
</body>
</html>
