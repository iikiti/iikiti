{% extends 'base/layout.twig' %}
{% set iikiti_can_edit = false %}
{% set iikiti_editor_mode = false %}
{% set iikiti_use_fragment_composer = false %}
{% set iikiti_icon_font = false %}
{% set iikiti_custom_css = '' %}
{% set iikiti_config = null %}

{% block head_styles %}
    {# The FOUC theme bootstrap lives in base/layout.twig and is inherited
       here via parent(); it runs before the admin stylesheets. #}
    {{ parent() }}
    {{ encore_entry_link_tags('admin') }}
{% endblock %}

{% block head_js %}
    {{ encore_entry_script_tags('admin', attributes={ defer: true }) }}
{% endblock %}

{% block body %}
    <div id="admin-app"
        data-api-token="{{ api_token }}"
        data-api-base="{{ api_base }}"
        data-site-host="{{ site_host }}"
        data-site-scheme="{{ site_scheme }}"
        data-time-zone="{{ time_zone }}"
        data-locale="{{ locale }}"
        data-current-user="{{ current_user }}"
        data-debug="{{ debug }}">
        <div class="min-h-screen flex items-center justify-center bg-bg">
            <div class="text-center">
                <div class="animate-spin rounded-full h-10 w-10 border-2 border-transparent border-t-accent mb-4"></div>
                <p class="text-text-muted">Loading administration…</p>
            </div>
        </div>
    </div>
{% endblock %}
