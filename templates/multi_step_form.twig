{% extends 'base/layout.twig' %}

{% block body %}
	<main class="multi-step-form mx-auto mt-12 w-full max-w-md px-4"
		data-flow="multistep"
		data-flow-action="{{ path(routeName, {'workflow': routeKey ?? workflow.name }) }}"
		data-flow-csrf="{{ csrf_token('multistep') }}">
		<h1 class="mb-2 text-2xl font-semibold">{{ step.name }}</h1>

		{% if workflow.steps|length > 1 %}
			<p class="mb-4 text-sm opacity-70">
				Step {{ workflow.currentStepIndex + 1 }} of {{ workflow.steps|length }}
			</p>
		{% endif %}

		<div class="native-form">
			{{ form_start(form) }}
				{{ form_errors(form) }}
				{% for field in form %}
					{{ form_row(field) }}
				{% endfor %}

				{% set transitions = workflow.getEnabledTransitionNamesForPlace(step.id)|filter(transition => not transition starts with 'back_') %}
				{% if transitions|length > 1 %}
					{% for transition in transitions %}
						<button type="submit" formaction="{{ path(routeName, {'workflow': routeKey ?? workflow.name, '_workflow_transition': transition}) }}" class="mt-4 rounded bg-blue-600 px-4 py-2 text-white">
							{{ transition|replace({'_': ' '})|capitalize }}
						</button>
					{% endfor %}
				{% else %}
					<button type="submit" class="mt-4 rounded bg-blue-600 px-4 py-2 text-white">
						Continue
					</button>
				{% endif %}
			{{ form_end(form) }}
		</div>
	</main>
{% endblock %}
