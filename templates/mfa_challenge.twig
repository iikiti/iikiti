{% extends 'base/layout.twig' %}

{% block body %}
	<main class="mfa-challenge mx-auto mt-12 w-full max-w-md px-4">
		<h1 class="mb-2 text-2xl font-semibold">Multi-factor authentication</h1>

		{% if workflow.steps|length > 1 %}
			<p class="mb-4 text-sm opacity-70">
				Step {{ workflow.currentStepIndex + 1 }} of {{ workflow.steps|length }}
			</p>
		{% endif %}

		<h2 class="mb-4 text-lg">{{ step.name }}</h2>

		{% for label, messages in app.flashes() %}
			{% for message in messages %}
				<div class="flash-{{ label }} mb-4 rounded border border-red-300 bg-red-50 p-3 text-red-800">
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		{% if form.vars.email is defined and form.vars.email %}
			<p class="mb-4 text-sm opacity-70">
				A verification code was sent to {{ form.vars.email }}.
			</p>
		{% endif %}

		{{ form_start(form) }}
			{{ form_errors(form) }}
			{% for field in form %}
				{{ form_row(field) }}
			{% endfor %}

			<button type="submit" class="mt-4 rounded bg-blue-600 px-4 py-2 text-white">
				Verify
			</button>
		{{ form_end(form) }}
	</main>
{% endblock %}
