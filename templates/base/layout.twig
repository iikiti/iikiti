<!DOCTYPE html>
<html lang="en" class="logged-in">
<head>
    {% block head %}
        {% block head_meta %}
            {% block meta_charset %}<meta charset="{{ (doc.meta.charset ?? 'UTF-8')|escape('html_attr') }}">{% endblock %}
            {% block meta_viewport %}<meta name="viewport" content="{{ (doc.meta.viewport ?? 'width=device-width, initial-scale=1')|escape('html_attr') }}">{% endblock %}
            {% block meta_favicon %}<link rel="shortcut icon" href="{{ asset('build/images/favicon.png') }}">{% endblock %}
        {% endblock %}
        {% block head_styles %}
            {# Theme bootstrap: apply the stored preference (or the OS
               preference when none is stored) before first paint to prevent
               FOUC. All front-end chrome (editor toolbar, floating panels,
               tooltips) follows the `--ik-*` tokens that flip with .dark. #}
            <script>
            (function () {
                var KEY = 'theme';
                var d = document.documentElement;
                var stored = (typeof localStorage !== 'undefined') ? localStorage.getItem(KEY) : null;
                var dark;
                if (stored === 'dark') { dark = true; }
                else if (stored === 'light') { dark = false; }
                else if (window.matchMedia) { dark = window.matchMedia('(prefers-color-scheme: dark)').matches; }
                if (dark) d.classList.add('dark');
            })();
            </script>
            {{ encore_entry_link_tags('tailwind') }}
            {% if iikiti_can_edit %}
                {{ encore_entry_link_tags('editor') }}
            {% endif %}
        {% endblock %}
        <title>{{ (doc.title ?? 'iikiti')|escape('html') }}</title>
        {% block head_js %}{% endblock %}
    {% endblock %}
</head>
	<body class="text-black bg-white dark:text-white dark:bg-gray-900{% if iikiti_can_edit %} iikiti-can-edit{% endif %}{% if iikiti_editor_mode %} iikiti-editor-body{% endif %}">
		{% block body_before %}{% endblock %}
		{% block body %}{{ iikiti_page_body|default('')|raw }}{% endblock %}
		{% if iikiti_config %}
			<script id="iikiti-config" type="application/json">{{ iikiti_config|json_encode|raw }}</script>
		{% endif %}
		{{ encore_entry_script_tags('iikiti') }}
		{% block body_after %}{% endblock %}
	</body>
</html>
