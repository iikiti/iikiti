{#
 * Default front-end layout (theme template) for the block editor.

 * Only `main` is a fixed content region. Header, footer, sidebars and dialogs
 * are shells (see ShellResolver): zero or more per role, rendered only when a
 * matching shell exists, so an empty role emits no markup at all.
 * `region_main` is the block tree for the main region; `iikiti_shells` maps role
 * to rendered shell HTML.
 #}

{% for html in iikiti_shells.header|default([]) %}
{{ iikiti_region('header-' ~ loop.index, 'header', 'Header', ['heading', 'text', 'image', 'icon', 'container'], html|raw) }}
{% endfor %}

{{ iikiti_region('main', 'main', 'Main content', ['heading', 'text', 'image', 'icon', 'video_embed', 'social_embed', 'query', 'container', 'dynamic'], region_main|default('')) }}

{% for html in iikiti_shells.aside|default([]) %}
{{ iikiti_region('aside-' ~ loop.index, 'sidebar', 'Sidebar', ['heading', 'text', 'image', 'icon', 'container'], html|raw) }}
{% endfor %}

{% for html in iikiti_shells.footer|default([]) %}
{{ iikiti_region('footer-' ~ loop.index, 'footer', 'Footer', ['heading', 'text', 'icon', 'container'], html|raw) }}
{% endfor %}

{% for html in iikiti_shells.dialog|default([]) %}
{{ iikiti_region('dialog-' ~ loop.index, 'dialog', 'Dialog', ['heading', 'text', 'image', 'icon', 'container'], html|raw) }}
{% endfor %}
